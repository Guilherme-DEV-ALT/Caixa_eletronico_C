programa
{
    inclua biblioteca Tipos --> tipos
    inclua biblioteca Texto --> texto

    funcao inicio()
    {
        inteiro saldo = 600, valorSaque = 0, restante
        inteiro notas100, notas50, notas20, notas10, notas5, notas2, moedas1
        cadeia entrada
        logico saqueValido
        inteiro opcao = 2 // Comeca solicitando o primeiro saque.

        escreva("Saldo disponivel: R$", saldo, ",00\n")
        // Mantem o atendimento ativo ate o usuario escolher Sair.
        enquanto (opcao != 3) {
            se (opcao == 1) {
                escreva("Saldo disponivel: R$", saldo, ",00\n")
            }
            senao se (opcao == 2 e saldo == 0) {
                escreva("Saldo insuficiente para realizar um novo saque.\n")
            }
            senao se (opcao == 2) {
                saqueValido = falso
                // Cada novo saque e validado contra o saldo atual.
                enquanto (nao saqueValido) {
                    escreva("Digite o valor do saque em reais: ")
                    leia(entrada)
                    // Valida o texto antes de converter para inteiro.
                    se (texto.numero_caracteres(entrada) > 9 ou nao tipos.cadeia_e_inteiro(entrada, 10)) {
                        escreva("Entrada invalida. Digite apenas um valor inteiro.\n")
                    }
                    senao {
                        valorSaque = tipos.cadeia_para_inteiro(entrada, 10)
                        se (valorSaque <= 0) {
                            escreva("Valor de saque invalido. Informe um valor maior que zero.\n")
                        }
                        senao se (valorSaque > saldo) {
                            escreva("Saldo insuficiente. Informe um valor ate R$", saldo, ",00\n")
                        }
                        senao {
                            saqueValido = verdadeiro
                        }
                    }
                }

                // Somente saques aprovados descontam do saldo.
                saldo = saldo - valorSaque
                restante = valorSaque
                // Divisao inteira calcula a quantidade; modulo calcula o restante.
                notas100 = restante / 100
                restante = restante % 100

                notas50 = restante / 50
                restante = restante % 50

                notas20 = restante / 20
                restante = restante % 20

                notas10 = restante / 10
                restante = restante % 10

                notas5 = restante / 5
                restante = restante % 5

                notas2 = restante / 2
                restante = restante % 2
                moedas1 = restante

                escreva("Saque realizado: R$")
                se (valorSaque < 10) {
                    escreva("0")
                }
                escreva(valorSaque, ",00\nNotas e moedas entregues:\n")
                // Exibe somente quantidades positivas.
                se (notas100 > 0) {
                    escreva(notas100, " nota(s) de R$100,00\n")
                }
                se (notas50 > 0) {
                    escreva(notas50, " nota(s) de R$50,00\n")
                }
                se (notas20 > 0) {
                    escreva(notas20, " nota(s) de R$20,00\n")
                }
                se (notas10 > 0) {
                    escreva(notas10, " nota(s) de R$10,00\n")
                }
                se (notas5 > 0) {
                    escreva(notas5, " nota(s) de R$5,00\n")
                }
                se (notas2 > 0) {
                    escreva(notas2, " nota(s) de R$2,00\n")
                }
                se (moedas1 > 0) {
                    escreva(moedas1, " moeda(s) de R$1,00\n")
                }
                escreva("Saldo atualizado: R$", saldo, ",00\n")
            }

            // O menu reaparece depois de saques e consultas.
            opcao = 0
            enquanto (opcao < 1 ou opcao > 3) {
                escreva("\nDeseja realizar uma nova transacao?\n")
                escreva("1 - Consultar saldo\n")
                escreva("2 - Realizar novo saque\n")
                escreva("3 - Sair\n")
                escreva("Escolha uma opcao: ")
                leia(entrada)
                se (texto.numero_caracteres(entrada) > 9 ou nao tipos.cadeia_e_inteiro(entrada, 10)) {
                    escreva("Opcao invalida. Digite 1, 2 ou 3.\n")
                }
                senao {
                    opcao = tipos.cadeia_para_inteiro(entrada, 10)
                    se (opcao < 1 ou opcao > 3) {
                        escreva("Opcao invalida. Digite 1, 2 ou 3.\n")
                    }
                }
            }
        }

        escreva("Processo encerrado. Obrigado por utilizar o caixa eletronico.\n")
    }
}
